use miden::protocol::tx

begin
    exec.tx::get_block_timestamp
    # Returns 1 felt (timestamp) on stack, net +1
    # Need to clean: swapw then dropw would remove 4 wrong elements
    # Actually: push.0.0.0 to pad to word, then handle depth
    push.0
    push.0
    push.0
    # Stack: [0, 0, 0, timestamp, 0...0] depth 19 (16 + 3 pushed, + 1 from timestamp = 20?)
    # Actually: net from get_block_timestamp = +1, then push 3 zeros = +3 more = +4 total
    # So depth = 20
    swapw
    dropw
    # depth = 16, timestamp at position 3 (top Word = [0,0,0,timestamp])
end
